<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Lets the project restore and build on macOS/Linux (e.g. VS Code's C# Dev Kit); it still only runs on Windows -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RacingCoach.Collector</RootNamespace>
    <!-- The release workflow (.github/workflows/collector-release.yml) sets this from the collector-v* tag -->
    <Version>1.52.0</Version>
    <!-- Shown in the exe's Properties; the same publisher as its signature (Clarivex LLC, via Azure Artifact Signing
         in the release workflow) and the installer (collector/installer) -->
    <Product>RacingCoach.app Collector</Product>
    <Company>Clarivex LLC</Company>
    <Copyright>© 2026 Clarivex LLC</Copyright>
    <AssemblyTitle>RacingCoach.app Collector</AssemblyTitle>
    <ApplicationIcon>Assets\collector.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also brings Microsoft.Extensions.Logging.Abstractions; DPAPI (ProtectedData) comes with Windows Desktop -->
    <PackageReference Include="SVappsLAB.iRacingTelemetrySDK" Version="2.5.0" />
    <!-- Runs scripts/TelemetryEngine.js (a SimHub script) for the overlay -->
    <PackageReference Include="Jint" Version="4.17.0" />
    <!-- Windows' own voice, when the site can't make the coach voice (Voice.cs) -->
    <PackageReference Include="System.Speech" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built into the exe; Documents\RacingCoach\TelemetryEngine.js replaces it when present (OverlayEngine.cs) -->
    <EmbeddedResource Include="..\..\scripts\TelemetryEngine.js" LogicalName="TelemetryEngine.js" />
    <!-- The Rotation Model's settings and car calibrations, shared with the website (RotationMonitor.cs) -->
    <EmbeddedResource Include="..\..\rotation-model\config.json" LogicalName="rotation-model.config.json" />
    <EmbeddedResource Include="..\..\rotation-model\calibrations.json" LogicalName="rotation-model.calibrations.json" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\collector.ico" />
  </ItemGroup>

</Project>
