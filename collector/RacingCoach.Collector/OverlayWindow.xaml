<Window x:Class="RacingCoach.Collector.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RacingCoach.Collector"
        Title="RacingCoach Overlay"
        Width="900" MinWidth="560" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Opacity="0.7" Topmost="True" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual" Left="40" Top="120"
        Icon="Assets/collector.ico"
        FontFamily="Segoe UI" FontSize="13" Foreground="#F3F4F6"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- See-through (Opacity above) so the sim shows through. Drag anywhere to move it. The height fits the
         one row of focus area values. -->
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9A9CA3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <!-- Read-only, and not hit-testable, so a click on a box drags the window like anywhere else -->
        <Style x:Key="Box" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="#1A1B1E" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="BorderBrush" Value="#303136" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <!-- Max Brake and Min Speed: about twice the size of the focus area boxes, the most that fits a
             speed like 123.4 in their 100 px width -->
        <Style x:Key="BigBox" TargetType="TextBox" BasedOn="{StaticResource Box}">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border Background="#121315" BorderBrush="#303136" BorderThickness="1" CornerRadius="10" Padding="14,10,14,14">
        <DockPanel>
            <!-- Header: the track, and a close button -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="✕" Click="Close_Click" local:Loc.ToolTip="overlay.close"
                        Width="26" Height="26" Padding="0" FontSize="12" Cursor="Hand" VerticalAlignment="Top"
                        Foreground="#F3F4F6" Background="#232428" BorderBrush="#303136" />
                <StackPanel>
                    <TextBlock FontWeight="Bold" FontSize="14">
                        <Run Text="RACINGCOACH" /><Run Text=" OVERLAY" Foreground="#DE3341" FontWeight="Normal" />
                    </TextBlock>
                    <TextBlock x:Name="TrackText" Foreground="#9A9CA3" FontSize="12" TextTrimming="CharacterEllipsis" Text="Waiting for iRacing…" />
                </StackPanel>
            </DockPanel>

            <!-- Peak brake pressure and minimum speed of the last few seconds -->
            <Grid DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="115" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource Heading}" local:Loc.Key="overlay.maxBrake" />
                    <TextBox x:Name="MaxBrakeBox" Style="{StaticResource BigBox}" Foreground="#EF4444" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <!-- With the speed unit, set in code -->
                    <TextBlock x:Name="MinSpeedHeading" Style="{StaticResource Heading}" />
                    <TextBox x:Name="MinSpeedBox" Style="{StaticResource BigBox}" Foreground="#8AB4F8" />
                </StackPanel>
                <!-- UNDERSTEER or OVERSTEER from the Rotation Model while it's sure; hidden (keeping its space) otherwise.
                     No heading: it sits at the bottom, level with the Max Brake and Min Speed boxes -->
                <TextBox x:Name="HandlingBox" Grid.Column="4" Style="{StaticResource BigBox}" MinWidth="230" Visibility="Hidden"
                         VerticalAlignment="Bottom" />
            </Grid>

            <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Foreground="#E3A82B" FontSize="12" TextWrapping="Wrap"
                       Margin="0,0,0,8" Visibility="Collapsed" />

            <!-- The In-Car Coach's latest message, for a while after it's shown -->
            <TextBlock x:Name="CoachText" DockPanel.Dock="Top" Foreground="#4ADE80" FontSize="16" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />

            <!-- The Upcoming Focus Area row: its name, then this lap's values; columns, headings and the row added in code -->
            <Grid x:Name="AreaGrid" VerticalAlignment="Top" />
        </DockPanel>
    </Border>
</Window>
