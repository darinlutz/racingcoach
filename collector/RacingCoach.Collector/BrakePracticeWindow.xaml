<Window x:Class="RacingCoach.Collector.BrakePracticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RacingCoach Brake Practice"
        Width="560" Height="380" MinWidth="360" MinHeight="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Opacity="0.85" Topmost="True" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual" Left="960" Top="120"
        Icon="Assets/collector.ico"
        FontFamily="Segoe UI" FontSize="13" Foreground="#F3F4F6"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="Background" Value="#232428" />
            <Setter Property="BorderBrush" Value="#303136" />
        </Style>
        <Style x:Key="PressPill" TargetType="TextBlock">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#9A9CA3" />
            <Setter Property="Background" Value="#232428" />
        </Style>
    </Window.Resources>

    <!-- Looks like the overlay (OverlayWindow.xaml): see-through so the sim shows through, drag anywhere to move it -->
    <Border Background="#121315" BorderBrush="#303136" BorderThickness="1" CornerRadius="10" Padding="14,10,14,14">
        <DockPanel>
            <!-- Header and a close button -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource HeaderButton}" Content="✕" Click="Close_Click" ToolTip="Close"
                        Width="26" Padding="0" />
                <Button x:Name="RecalibrateButton" DockPanel.Dock="Right" Style="{StaticResource HeaderButton}" Content="Recalibrate"
                        Click="Recalibrate_Click" Padding="10,0" Margin="0,0,8,0" Visibility="Collapsed" />
                <!-- The exact brake percentage being applied -->
                <TextBlock x:Name="BrakeReadout" DockPanel.Dock="Right" Margin="0,0,12,0" VerticalAlignment="Center"
                           FontSize="34" FontWeight="Bold" FontFamily="Consolas" Foreground="#EF4444" Text="—" Visibility="Collapsed" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontWeight="Bold" FontSize="14">
                        <Run Text="RACINGCOACH" /><Run Text=" BRAKE PRACTICE" Foreground="#3B8BFF" FontWeight="Normal" />
                    </TextBlock>
                    <TextBlock x:Name="StatusText" Foreground="#9A9CA3" FontSize="12" TextTrimming="CharacterEllipsis" Text="Looking for your Simucube pedals…" />
                </StackPanel>
            </DockPanel>

            <Grid>
                <!-- Step 1: press the brake fully down twice -->
                <Border x:Name="CalibrationPanel" Background="#1A1B1E" BorderBrush="#303136" BorderThickness="1" CornerRadius="6" Padding="20,16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Calibrate pedal" FontSize="20" FontWeight="Bold" />
                        <TextBlock x:Name="CalibrationText" Foreground="#9A9CA3" Margin="0,4,0,16" TextWrapping="Wrap"
                                   Text="Press the brake fully down twice." />
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock x:Name="PositionText" DockPanel.Dock="Right" FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                                       Foreground="#EF4444" Text="—" />
                            <TextBlock Text="Position" Foreground="#9A9CA3" VerticalAlignment="Bottom" />
                        </DockPanel>
                        <Border x:Name="PositionTrack" Height="18" CornerRadius="4" Background="#232428">
                            <Border x:Name="PositionBar" HorizontalAlignment="Left" Width="0" CornerRadius="4" Background="#EF4444" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <TextBlock x:Name="Press1" Style="{StaticResource PressPill}" Text="Press 1" />
                            <TextBlock x:Name="Press2" Style="{StaticResource PressPill}" Text="Press 2" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Step 2: brake % over the last few seconds, newest on the right, with lines at 20, 40, 60, 80 and 100% -->
                <Border x:Name="GraphPanel" Background="#1A1B1E" BorderBrush="#303136" BorderThickness="1" CornerRadius="6" Visibility="Collapsed">
                    <Canvas x:Name="Graph" ClipToBounds="True" SizeChanged="Graph_SizeChanged" />
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
