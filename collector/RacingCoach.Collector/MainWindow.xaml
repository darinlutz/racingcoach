<Window x:Class="RacingCoach.Collector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RacingCoach.Collector"
        Title="RacingCoach.app Collector"
        Width="1180" Height="840" MinWidth="980" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/collector.ico"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- Colors follow RacingCoach.app's dark theme (src/app/globals.css) -->
    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#121315" />
        <SolidColorBrush x:Key="CardBrush" Color="#1A1B1E" />
        <SolidColorBrush x:Key="SecondaryBrush" Color="#232428" />
        <SolidColorBrush x:Key="BorderBrush" Color="#303136" />
        <SolidColorBrush x:Key="FgBrush" Color="#F3F4F6" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9A9CA3" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#DE3341" />
        <SolidColorBrush x:Key="GreenBrush" Color="#2EB872" />
        <SolidColorBrush x:Key="AmberBrush" Color="#E3A82B" />
        <SolidColorBrush x:Key="BlueBrush" Color="#3B8BFF" />
        <SolidColorBrush x:Key="GreyBrush" Color="#6B6D74" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Bar" TargetType="Border">
            <Setter Property="Height" Value="8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="RenderTransformOrigin" Value="0,0.5" />
        </Style>
        <Style x:Key="BarTrack" TargetType="Border">
            <Setter Property="Height" Value="8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{StaticResource SecondaryBrush}" />
        </Style>

        <Style x:Key="Button" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource Button}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
        </Style>
        <Style x:Key="BlueButton" TargetType="Button" BasedOn="{StaticResource Button}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource BlueBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BlueBrush}" />
        </Style>

        <!-- A dropdown in the window's colors (WPF's own draws a light box whatever its Background) -->
        <Style x:Key="ComboToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Box" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Data="M0,0 L4,4 L8,0"
                                  Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Combo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Style="{StaticResource ComboToggle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter Margin="8,3,24,3" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade">
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="0,3" MaxHeight="260"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Row" Background="Transparent" Padding="8,4">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource SecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource BlueBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The tabs under the header: Dashboard (the status tiles, session, live inputs, laps and activity) and Live Racing -->
        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,26,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Underline" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="2,0,2,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
                                <Setter TargetName="Underline" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A status tile in the row under the header -->
        <Style x:Key="Dot" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{StaticResource GreyBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel Margin="20,16,20,20">

            <!-- Header -->
            <!-- Two columns, so the buttons never cover the title -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Image Source="Assets/collector.ico" Width="34" Height="34" Margin="0,0,12,0" />
                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="Bold">
                            <Run Text="RACINGCOACH" /><Run Text=" COLLECTOR" Foreground="{StaticResource PrimaryBrush}" FontWeight="Normal" />
                        </TextBlock>
                        <TextBlock x:Name="SubtitleText" Style="{StaticResource Muted}" FontSize="12" local:Loc.Key="main.subtitle" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Button}" local:Loc.Key="main.uploadKey" Click="ChangeKey_Click" Margin="0,0,8,0" x:Name="KeyButton" />
                        <Button Style="{StaticResource Button}" Content="RacingCoach.app" Click="OpenSite_Click" Margin="0,0,8,0" />
                        <!-- Coaches and Admins only (CollectorEngine.CanCoach) -->
                        <Button x:Name="RotationButton" Style="{StaticResource PrimaryButton}" local:Loc.Key="main.rotationOverlay" Click="Rotation_Click" Margin="0,0,8,0"
                                Visibility="Collapsed" />
                        <Button Style="{StaticResource PrimaryButton}" local:Loc.Key="main.targetTelemetryOverlay" Click="TargetTelemetry_Click" Margin="0,0,8,0" />
                        <Button Style="{StaticResource PrimaryButton}" local:Loc.Key="main.steeringOverlay" Click="Steering_Click" />
                    </StackPanel>
                    <Button Style="{StaticResource BlueButton}" local:Loc.Key="main.brakePractice" Click="BrakePractice_Click"
                            HorizontalAlignment="Right" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>

            <!-- Newer version: downloading, ready to install (Restart Now), or the manual Download fallback -->
            <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,14" CornerRadius="10" Padding="16,10"
                    Background="#1F3A5F" BorderBrush="{StaticResource BlueBrush}" BorderThickness="1">
                <DockPanel>
                    <Button x:Name="UpdateButton" DockPanel.Dock="Right" Style="{StaticResource Button}" Content="Download" Click="UpdateButton_Click" Margin="12,0,0,0" />
                    <TextBlock x:Name="UpdateText" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- The upload key's account hasn't accepted the current Terms of Service and Privacy Policy
                 (CollectorEngine.PoliciesAccepted): Review opens the website, which asks for it -->
            <Border x:Name="PoliciesBanner" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,14" CornerRadius="10" Padding="16,10"
                    Background="#3A2F14" BorderBrush="{StaticResource AmberBrush}" BorderThickness="1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button}" local:Loc.Key="main.review" Click="OpenSite_Click" Margin="12,0,0,0" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                               local:Loc.Key="main.policiesUpdated" />
                </DockPanel>
            </Border>

            <!-- Tabs -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="DashboardTab" Style="{StaticResource Tab}" GroupName="Tabs" local:Loc.Key="main.dashboard" IsChecked="True" Checked="Tab_Checked" />
                    <RadioButton x:Name="LiveRacingTab" Style="{StaticResource Tab}" GroupName="Tabs" local:Loc.Key="main.liveRacing" Checked="Tab_Checked" />
                </StackPanel>
            </Border>

            <Grid>
            <DockPanel x:Name="DashboardPanel">
            <!-- Status tiles -->
            <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="-6,0,-6,14">
                <Border Style="{StaticResource Card}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" local:Loc.Key="main.simulator" />
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="SimDot" Style="{StaticResource Dot}" />
                            <TextBlock x:Name="SimText" Style="{StaticResource Value}" local:Loc.Key="main.starting" />
                        </StackPanel>
                        <TextBlock x:Name="SimDetail" Style="{StaticResource Muted}" Margin="18,2,0,0" />
                        <!-- Which simulator is read (CollectorEngine.SelectSimulator, saved in collector.json); iRacing by default -->
                        <ComboBox x:Name="SimulatorCombo" Style="{StaticResource Combo}" Margin="18,8,0,0" local:Loc.ToolTip="main.simulatorTip"
                                  SelectionChanged="SimulatorCombo_SelectionChanged" />
                        <!-- ACC only: the wheel's rotation lock to lock, which ACC's steering angle needs (CollectorEngine.SetSteeringRange,
                             saved as steeringRange); saved on Enter or leaving the box, empty for none -->
                        <StackPanel x:Name="SteeringRangePanel" Margin="18,8,0,0" Visibility="Collapsed">
                            <TextBlock local:Loc.Key="main.wheelRotation" FontSize="12" Margin="0,0,0,3" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="SteeringRangeBox" Width="64" FontSize="12" Padding="6,3" MaxLength="4"
                                         Background="{StaticResource SecondaryBrush}" Foreground="{StaticResource FgBrush}"
                                         BorderBrush="{StaticResource BorderBrush}" CaretBrush="{StaticResource FgBrush}"
                                         local:Loc.ToolTip="main.wheelRotationTip"
                                         KeyDown="SteeringRangeBox_KeyDown" LostKeyboardFocus="SteeringRangeBox_LostFocus" />
                                <TextBlock Text="°" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="SteeringRangeHint" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"
                                       TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" local:Loc.Key="main.lapRecording" />
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="RecordDot" Style="{StaticResource Dot}" />
                            <TextBlock x:Name="RecordText" Style="{StaticResource Value}" local:Loc.Key="main.notRecording" />
                        </StackPanel>
                        <TextBlock x:Name="RecordDetail" Style="{StaticResource Muted}" Margin="18,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" local:Loc.Key="main.uploads" />
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="UploadDot" Style="{StaticResource Dot}" />
                            <TextBlock x:Name="UploadText" Style="{StaticResource Value}" local:Loc.Key="main.checking" />
                        </StackPanel>
                        <!-- The account's Preferred Language and Units, under its name -->
                        <TextBlock x:Name="PreferencesText" Style="{StaticResource Muted}" FontSize="11" Margin="18,1,0,0" Visibility="Collapsed" />
                        <!-- Under them, "Beeps before braking" (BrakeBeeps.cs), saved to the account; with it on, its volume and a
                             Test button that plays the beeps at that volume -->
                        <StackPanel x:Name="BeepsPanel" Margin="18,6,0,0" Visibility="Collapsed">
                            <CheckBox x:Name="BeepsCheck" local:Loc.Key="main.beeps" Foreground="{StaticResource FgBrush}" FontSize="12"
                                      Click="BeepsCheck_Click"
                                      local:Loc.ToolTip="main.beepsTip" />
                            <DockPanel x:Name="BeepsVolumeRow" Margin="0,4,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button}" local:Loc.Key="main.test" Padding="8,2" FontSize="11"
                                        Margin="6,0,0,0" Click="TestBeeps_Click" local:Loc.ToolTip="main.testTip" />
                                <TextBlock x:Name="BeepsVolumeText" DockPanel.Dock="Right" Width="36" TextAlignment="Right" FontSize="12"
                                           VerticalAlignment="Center" />
                                <Slider x:Name="BeepsVolumeSlider" Minimum="10" Maximum="100" Value="62" SmallChange="1" LargeChange="10"
                                        IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                        local:Loc.ToolTip="main.volume" ValueChanged="BeepsVolume_ValueChanged" />
                            </DockPanel>
                        </StackPanel>
                        <!-- Under them, Driver Radio's microphone (MicRecorder.DeviceName, saved in collector.json) and a bar
                             that moves with what it hears, so the driver can see their voice is picked up -->
                        <StackPanel Margin="18,8,0,0">
                            <TextBlock local:Loc.Key="main.microphone" FontSize="12" Margin="0,0,0,3" />
                            <ComboBox x:Name="MicCombo" Style="{StaticResource Combo}" local:Loc.ToolTip="main.microphoneTip"
                                      DropDownOpened="MicCombo_DropDownOpened" SelectionChanged="MicCombo_SelectionChanged" />
                            <Border Style="{StaticResource BarTrack}" Margin="0,5,0,0" Background="Transparent" local:Loc.ToolTip="main.micLevelTip">
                                <Border x:Name="MicLevelBar" Style="{StaticResource Bar}" HorizontalAlignment="Left" Width="0"
                                        Background="{StaticResource GreenBrush}" />
                            </Border>
                            <TextBlock x:Name="MicProblemText" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" Visibility="Collapsed" />
                        </StackPanel>
                        <TextBlock x:Name="UploadDetail" Style="{StaticResource Muted}" Margin="18,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" local:Loc.Key="main.trackPositions" />
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="IbtDot" Style="{StaticResource Dot}" />
                            <TextBlock x:Name="IbtText" Style="{StaticResource Value}" />
                        </StackPanel>
                        <TextBlock x:Name="IbtDetail" Style="{StaticResource Muted}" Margin="18,2,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>

                <!-- Session, car and conditions -->
                <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Grid.Column="0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" local:Loc.Key="main.track" />
                            <TextBlock x:Name="TrackText" Style="{StaticResource Value}" FontSize="17" Text="—" TextWrapping="Wrap" />
                            <TextBlock x:Name="TrackDetail" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Label}" local:Loc.Key="main.car" Margin="0,14,0,4" />
                            <TextBlock x:Name="CarText" Style="{StaticResource Value}" FontSize="17" Text="—" TextWrapping="Wrap" />
                            <TextBlock x:Name="CarDetail" Style="{StaticResource Muted}" />
                            <TextBlock Style="{StaticResource Label}" local:Loc.Key="main.session" Margin="0,14,0,4" />
                            <TextBlock x:Name="SessionText" Style="{StaticResource Value}" Text="—" />
                            <TextBlock x:Name="SessionDetail" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Grid.Column="2">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" local:Loc.Key="main.fuel" />
                            <DockPanel>
                                <TextBlock x:Name="FuelPctText" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Bottom" />
                                <TextBlock x:Name="FuelText" Style="{StaticResource Value}" FontSize="17" Text="—" />
                            </DockPanel>
                            <Grid Margin="0,6,0,0">
                                <Border Style="{StaticResource BarTrack}" />
                                <Border x:Name="FuelBar" Style="{StaticResource Bar}" Background="{StaticResource AmberBrush}">
                                    <Border.RenderTransform><ScaleTransform x:Name="FuelScale" ScaleX="0" /></Border.RenderTransform>
                                </Border>
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Label}" local:Loc.Key="main.trackTemp" />
                                    <TextBlock x:Name="TrackTempText" Style="{StaticResource Value}" Text="—" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource Label}" local:Loc.Key="main.airTemp" />
                                    <TextBlock x:Name="AirTempText" Style="{StaticResource Value}" Text="—" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="SkiesText" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Label}" local:Loc.Key="main.timeLeft" />
                                    <TextBlock x:Name="TimeLeftText" Style="{StaticResource Value}" Text="—" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource Label}" local:Loc.Key="main.lapsLeft" />
                                    <TextBlock x:Name="LapsLeftText" Style="{StaticResource Value}" Text="—" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Live inputs -->
                <Border Style="{StaticResource Card}" Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" local:Loc.Key="main.live" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock x:Name="SpeedText" FontSize="44" FontWeight="Bold" Text="—" />
                                <TextBlock x:Name="SpeedUnitText" Text="mph" FontSize="16" FontWeight="SemiBold" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="4,0,0,9" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Style="{StaticResource Label}" local:Loc.Key="main.gear" HorizontalAlignment="Right" />
                                <TextBlock x:Name="GearText" FontSize="32" FontWeight="Bold" Text="—" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="RpmText" Style="{StaticResource Muted}" Text="— RPM" Margin="0,-4,0,10" />

                        <DockPanel>
                            <TextBlock x:Name="ThrottleText" DockPanel.Dock="Right" Style="{StaticResource Muted}" Width="40" TextAlignment="Right" />
                            <TextBlock local:Loc.Key="main.throttle" Width="76" Style="{StaticResource Muted}" />
                            <Grid VerticalAlignment="Center">
                                <Border Style="{StaticResource BarTrack}" />
                                <Border Style="{StaticResource Bar}" Background="{StaticResource GreenBrush}">
                                    <Border.RenderTransform><ScaleTransform x:Name="ThrottleScale" ScaleX="0" /></Border.RenderTransform>
                                </Border>
                            </Grid>
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock x:Name="BrakeText" DockPanel.Dock="Right" Style="{StaticResource Muted}" Width="40" TextAlignment="Right" />
                            <TextBlock local:Loc.Key="main.brake" Width="76" Style="{StaticResource Muted}" />
                            <Grid VerticalAlignment="Center">
                                <Border Style="{StaticResource BarTrack}" />
                                <Border Style="{StaticResource Bar}" Background="{StaticResource PrimaryBrush}">
                                    <Border.RenderTransform><ScaleTransform x:Name="BrakeScale" ScaleX="0" /></Border.RenderTransform>
                                </Border>
                            </Grid>
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock x:Name="SteeringText" DockPanel.Dock="Right" Style="{StaticResource Muted}" Width="40" TextAlignment="Right" />
                            <TextBlock local:Loc.Key="main.steering" Width="76" Style="{StaticResource Muted}" />
                            <Grid x:Name="SteeringTrack" VerticalAlignment="Center">
                                <Border Style="{StaticResource BarTrack}" />
                                <Border Width="2" Height="12" Background="{StaticResource GreyBrush}" HorizontalAlignment="Center" />
                                <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource BlueBrush}" HorizontalAlignment="Center">
                                    <Border.RenderTransform><TranslateTransform x:Name="SteeringShift" /></Border.RenderTransform>
                                </Border>
                            </Grid>
                        </DockPanel>

                        <DockPanel Margin="0,14,0,0">
                            <TextBlock x:Name="LapProgressText" DockPanel.Dock="Right" Style="{StaticResource Muted}" />
                            <TextBlock x:Name="LapNumberText" Style="{StaticResource Muted}" Text="Lap —" />
                        </DockPanel>
                        <Grid Margin="0,6,0,0">
                            <Border Style="{StaticResource BarTrack}" />
                            <Border Style="{StaticResource Bar}" Background="{StaticResource BlueBrush}">
                                <Border.RenderTransform><ScaleTransform x:Name="LapScale" ScaleX="0" /></Border.RenderTransform>
                            </Border>
                        </Grid>

                        <UniformGrid Columns="4" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}" local:Loc.Key="main.current" />
                                <TextBlock x:Name="CurrentLapText" Style="{StaticResource Value}" Text="—" FontFamily="Consolas" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}" local:Loc.Key="main.last" />
                                <TextBlock x:Name="LastLapText" Style="{StaticResource Value}" Text="—" FontFamily="Consolas" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}" local:Loc.Key="main.best" />
                                <TextBlock x:Name="BestLapText" Style="{StaticResource Value}" Text="—" FontFamily="Consolas" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}" local:Loc.Key="main.vsBest" />
                                <TextBlock x:Name="DeltaText" Style="{StaticResource Value}" Text="—" FontFamily="Consolas" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- This session's laps -->
                <Border Style="{StaticResource Card}" Grid.Row="1" Grid.Column="0" Padding="0,14,0,8">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="16,0,16,8">
                            <TextBlock x:Name="LapsSummaryText" DockPanel.Dock="Right" Style="{StaticResource Muted}" />
                            <TextBlock x:Name="LapsTitle" Style="{StaticResource Label}" local:Loc.Key="main.lapsThisSession" />
                        </DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="16,0,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="74" />
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="104" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Label}" local:Loc.Key="main.colLap" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Label}" local:Loc.Key="main.colTime" />
                            <TextBlock Grid.Column="2" Style="{StaticResource Label}" local:Loc.Key="main.colToBest" />
                            <TextBlock Grid.Column="3" Style="{StaticResource Label}" local:Loc.Key="main.colIncidents" />
                            <TextBlock Grid.Column="4" Style="{StaticResource Label}" local:Loc.Key="main.colNotes" />
                            <TextBlock Grid.Column="5" Style="{StaticResource Label}" local:Loc.Key="main.colUploaded" />
                            <TextBlock Grid.Column="6" Style="{StaticResource Label}" local:Loc.Key="main.colPositions" />
                        </Grid>
                        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush}" />
                        <Grid>
                            <TextBlock x:Name="NoLapsText" Style="{StaticResource Muted}" Margin="16,14" TextWrapping="Wrap"
                                       local:Loc.Key="main.noLaps" />
                            <ScrollViewer x:Name="LapsScroll" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="LapsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding RowBackground}" Padding="16,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="86" />
                                                        <ColumnDefinition Width="74" />
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="104" />
                                                        <ColumnDefinition Width="104" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Lap}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Time}" FontFamily="Consolas" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Gap}" FontFamily="Consolas" Foreground="{Binding GapBrush}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Incidents}" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Notes}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Notes}" />
                                                    <TextBlock Grid.Column="5" Text="{Binding Upload}" Foreground="{Binding UploadBrush}" ToolTip="{Binding UploadTip}" />
                                                    <TextBlock Grid.Column="6" Text="{Binding Positions}" Foreground="{Binding PositionsBrush}" ToolTip="{Binding PositionsTip}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Activity -->
                <Border Style="{StaticResource Card}" Grid.Row="1" Grid.Column="2" Padding="0,14,0,8">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="16,0,16,8">
                            <TextBlock DockPanel.Dock="Right">
                                <Hyperlink Click="OpenLogFile_Click" Foreground="{StaticResource MutedBrush}"><Run local:Loc.Key="main.logFile" /></Hyperlink>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Label}" local:Loc.Key="main.activity" />
                        </DockPanel>
                        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush}" />
                        <ScrollViewer x:Name="ActivityScroll" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ActivityList" Margin="16,6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Width="62" Foreground="{StaticResource MutedBrush}" FontFamily="Consolas" />
                                            <TextBlock Text="{Binding Message}" Foreground="{Binding Brush}" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
            </DockPanel>

            <!-- Live Racing: the track's map with the car going round it (TrackMapView), and the live lap details, shared
                 with the website's Live Racing page, where friends and coaches can watch (LiveRacing.cs) -->
            <Grid x:Name="LivePanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="16,14">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <TextBlock x:Name="MapKindText" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBlock x:Name="MapTrackText" Style="{StaticResource Value}" FontSize="17" Text="—" />
                        </DockPanel>
                        <TextBlock x:Name="MapNoteText" DockPanel.Dock="Bottom" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <!-- The satellite imagery's opacity under an exact map, 0-100% (as on the website's Live Racing page),
                             shown when the site has imagery set up; saved in collector.json -->
                        <StackPanel x:Name="SatelliteRow" DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Muted}" local:Loc.Key="main.satellite" VerticalAlignment="Center" />
                            <Slider x:Name="SatelliteSlider" Width="128" Minimum="0" Maximum="100" Value="60" SmallChange="5" LargeChange="5"
                                    IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" Margin="8,0"
                                    local:Loc.ToolTip="main.satelliteTip" ValueChanged="Satellite_ValueChanged" />
                            <TextBlock x:Name="SatelliteText" Style="{StaticResource Muted}" Width="36" VerticalAlignment="Center" Text="60%" />
                        </StackPanel>
                        <Grid>
                            <local:TrackMapView x:Name="TrackMap" />
                            <TextBlock x:Name="MapEmptyText" Style="{StaticResource Muted}" FontSize="15" TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" />
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Card}" Grid.Column="2">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" local:Loc.Key="main.sharingLive" />
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ShareDot" Style="{StaticResource Dot}" />
                            <TextBlock x:Name="ShareText" Style="{StaticResource Value}" local:Loc.Key="main.notSharing" />
                        </StackPanel>
                        <TextBlock x:Name="ShareDetail" Style="{StaticResource Muted}" Margin="18,2,0,0" TextWrapping="Wrap" />
                        <Button Style="{StaticResource Button}" local:Loc.Key="main.watchOnSite" Click="OpenLiveRacing_Click" Margin="0,10,0,0"
                                HorizontalAlignment="Left" local:Loc.ToolTip="main.watchOnSiteTip" />

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16" />

                        <!-- Driver Radio (DriverRadio.cs): hold iRacing's radio button, or the wheel button set here, and speak -->
                        <TextBlock Style="{StaticResource Label}" local:Loc.Key="main.driverRadio" />
                        <TextBlock x:Name="RadioText" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                   local:Loc.Key="main.radioIdle" />
                        <TextBlock x:Name="RadioButtonText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="SetRadioButton" Style="{StaticResource Button}" local:Loc.Key="main.setWheelButton" Click="SetRadioButton_Click"
                                    local:Loc.ToolTip="main.setWheelButtonTip" />
                            <Button x:Name="ClearRadioButton" Style="{StaticResource Button}" local:Loc.Key="main.clear" Click="ClearRadioButton_Click" Margin="8,0,0,0" />
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock x:Name="LiveSpeedText" FontSize="40" FontWeight="Bold" Text="—" />
                                <TextBlock x:Name="LiveSpeedUnitText" Text="mph" FontSize="15" FontWeight="SemiBold" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="4,0,0,8" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Style="{StaticResource Label}" local:Loc.Key="main.gear" HorizontalAlignment="Right" />
                                <TextBlock x:Name="LiveGearText" FontSize="30" FontWeight="Bold" Text="—" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="LiveLapText" Style="{StaticResource Muted}" Text="Lap —" Margin="0,2,0,0" />

                        <UniformGrid Columns="2" Margin="0,14,0,0">
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource Label}" local:Loc.Key="main.current" />
                                <TextBlock x:Name="LiveCurrentText" Style="{StaticResource Value}" Text="—" FontFamily="Consolas" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource Label}" local:Loc.Key="main.vsBest" />
                                <TextBlock x:Name="LiveDeltaText" Style="{StaticResource Value}" Text="—" FontFamily="Consolas" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}" local:Loc.Key="main.last" />
                                <TextBlock x:Name="LiveLastText" Style="{StaticResource Value}" Text="—" FontFamily="Consolas" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}" local:Loc.Key="main.best" />
                                <TextBlock x:Name="LiveBestText" Style="{StaticResource Value}" Text="—" FontFamily="Consolas" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Style="{StaticResource Label}" local:Loc.Key="main.focusArea" Margin="0,16,0,4" />
                        <TextBlock x:Name="LiveAreaText" Style="{StaticResource Value}" Text="—" />
                    </StackPanel>
                </Border>
            </Grid>
            </Grid>
        </DockPanel>

        <!-- Upload key entry -->
        <Grid x:Name="KeyOverlay" Background="#D9000000" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Width="560" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="26,22">
                <StackPanel>
                    <TextBlock local:Loc.Key="main.connectTitle" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock x:Name="KeyIntro" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14">
                        <Run local:Loc.Key="main.keyHowToStart" />
                        <Hyperlink Click="OpenAccount_Click" Foreground="{StaticResource PrimaryBrush}"><Run local:Loc.Key="main.accountPage" /></Hyperlink>
                        <Run local:Loc.Key="main.keyHowToEnd" />
                    </TextBlock>
                    <TextBox x:Name="KeyBox" FontFamily="Consolas" FontSize="14" Padding="10,8"
                             Background="{StaticResource SecondaryBrush}" Foreground="{StaticResource FgBrush}"
                             BorderBrush="{StaticResource BorderBrush}" CaretBrush="{StaticResource FgBrush}"
                             KeyDown="KeyBox_KeyDown" />
                    <TextBlock x:Name="KeyStatusText" TextWrapping="Wrap" Margin="0,8,0,0" MinHeight="18" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button x:Name="KeySkipButton" Style="{StaticResource Button}" local:Loc.Key="main.skip" Click="KeySkip_Click" Margin="0,0,8,0" />
                        <Button x:Name="KeyConnectButton" Style="{StaticResource PrimaryButton}" local:Loc.Key="main.connect" Click="KeyConnect_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Shown while closing: the last laps are saved and queued uploads get a few seconds -->
        <Grid x:Name="ClosingOverlay" Background="#D9000000" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="26,20">
                <StackPanel>
                    <TextBlock local:Loc.Key="main.finishing" FontSize="18" FontWeight="Bold" />
                    <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"
                               local:Loc.Key="main.finishingDetail" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
