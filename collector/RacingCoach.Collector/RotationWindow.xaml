<Window x:Class="RacingCoach.Collector.RotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RacingCoach Rotation"
        Width="460" MinWidth="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Opacity="0.7" Topmost="True" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual" Left="960" Top="120"
        Icon="Assets/collector.ico"
        FontFamily="Segoe UI" FontSize="13" Foreground="#F3F4F6"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- Looks like the overlay (OverlayWindow.xaml): see-through so the sim shows through, drag anywhere to move it -->
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9A9CA3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <!-- Read-only, and not hit-testable, so a click on a box drags the window like anywhere else -->
        <Style x:Key="Box" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="#1A1B1E" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="BorderBrush" Value="#303136" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <!-- iRacing's own value and units, under each box -->
        <Style x:Key="Raw" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9A9CA3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,0,10" />
        </Style>
    </Window.Resources>

    <Border Background="#121315" BorderBrush="#303136" BorderThickness="1" CornerRadius="10" Padding="14,10,14,4">
        <DockPanel>
            <!-- Header and a close button -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="✕" Click="Close_Click" ToolTip="Close"
                        Width="26" Height="26" Padding="0" FontSize="12" Cursor="Hand" VerticalAlignment="Top"
                        Foreground="#F3F4F6" Background="#232428" BorderBrush="#303136" />
                <StackPanel>
                    <TextBlock FontWeight="Bold" FontSize="14">
                        <Run Text="RACINGCOACH" /><Run Text=" ROTATION" Foreground="#DE3341" FontWeight="Normal" />
                    </TextBlock>
                    <TextBlock x:Name="StatusText" Foreground="#9A9CA3" FontSize="12" TextTrimming="CharacterEllipsis" Text="Waiting for iRacing…" />
                </StackPanel>
            </DockPanel>

            <!-- The Rotation Model (RotationMonitor): its label, and the numbers behind it -->
            <Grid DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
                    <TextBlock Style="{StaticResource Heading}" Text="Handling" />
                    <TextBox x:Name="HandlingBox" Style="{StaticResource Box}" FontSize="28" />
                    <!-- Balance gauges: each bar sits in the middle when neutral, moves left (blue) by the understeer and
                         right (red) by the oversteer; ticks at 50% each way. Severity is how much, Confidence how sure -->
                    <TextBlock Style="{StaticResource Heading}" Text="Severity (how much)" Margin="0,8,0,4" />
                    <Border Height="26" Background="#1A1B1E" BorderBrush="#303136" BorderThickness="1">
                        <Canvas x:Name="SeverityGauge" ClipToBounds="True" SizeChanged="Gauge_SizeChanged" />
                    </Border>
                    <DockPanel Margin="0,2,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="◀ UNDERSTEER" Foreground="#3B8BFF" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock DockPanel.Dock="Right" Text="OVERSTEER ▶" Foreground="#EF4444" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock x:Name="SeverityText" Text="" Foreground="#9A9CA3" FontSize="10" HorizontalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="Confidence (how sure)" Margin="0,8,0,4" />
                    <Border Height="26" Background="#1A1B1E" BorderBrush="#303136" BorderThickness="1">
                        <Canvas x:Name="ConfidenceGauge" ClipToBounds="True" SizeChanged="Gauge_SizeChanged" />
                    </Border>
                    <DockPanel Margin="0,2,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="◀ UNDERSTEER" Foreground="#3B8BFF" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock DockPanel.Dock="Right" Text="OVERSTEER ▶" Foreground="#EF4444" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock x:Name="ConfidenceText" Text="" Foreground="#9A9CA3" FontSize="10" HorizontalAlignment="Center" />
                    </DockPanel>
                    <TextBlock x:Name="HandlingStatus" Style="{StaticResource Raw}" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0">
                    <TextBlock Style="{StaticResource Heading}" Text="Sideslip" />
                    <TextBox x:Name="SideslipBox" Style="{StaticResource Box}" />
                    <TextBlock x:Name="SideslipRaw" Style="{StaticResource Raw}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2">
                    <TextBlock Style="{StaticResource Heading}" Text="Yaw Rate vs Expected" />
                    <TextBox x:Name="YawRatioBox" Style="{StaticResource Box}" />
                    <TextBlock x:Name="YawRatioRaw" Style="{StaticResource Raw}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Style="{StaticResource Heading}" Text="Understeer" />
                    <TextBox x:Name="UndersteerBox" Style="{StaticResource Box}" />
                    <TextBlock x:Name="UndersteerRaw" Style="{StaticResource Raw}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Style="{StaticResource Heading}" Text="Oversteer" />
                    <TextBox x:Name="OversteerBox" Style="{StaticResource Box}" />
                    <TextBlock x:Name="OversteerRaw" Style="{StaticResource Raw}" />
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Style="{StaticResource Heading}" Text="Steering Wheel Angle" />
                    <TextBox x:Name="SteeringBox" Style="{StaticResource Box}" />
                    <TextBlock x:Name="SteeringRaw" Style="{StaticResource Raw}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Style="{StaticResource Heading}" Text="Speed" />
                    <TextBox x:Name="SpeedBox" Style="{StaticResource Box}" Foreground="#8AB4F8" />
                    <TextBlock x:Name="SpeedRaw" Style="{StaticResource Raw}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0">
                    <TextBlock Style="{StaticResource Heading}" Text="Yaw Rate" />
                    <TextBox x:Name="YawRateBox" Style="{StaticResource Box}" />
                    <TextBlock x:Name="YawRateRaw" Style="{StaticResource Raw}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2">
                    <TextBlock Style="{StaticResource Heading}" Text="Yaw" />
                    <TextBox x:Name="YawBox" Style="{StaticResource Box}" />
                    <TextBlock x:Name="YawRaw" Style="{StaticResource Raw}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Style="{StaticResource Heading}" Text="Velocity X (forward)" />
                    <TextBox x:Name="VelocityXBox" Style="{StaticResource Box}" />
                    <TextBlock x:Name="VelocityXRaw" Style="{StaticResource Raw}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Style="{StaticResource Heading}" Text="Velocity Y (sideways)" />
                    <TextBox x:Name="VelocityYBox" Style="{StaticResource Box}" />
                    <TextBlock x:Name="VelocityYRaw" Style="{StaticResource Raw}" />
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0">
                    <TextBlock Style="{StaticResource Heading}" Text="Lateral Accel" />
                    <TextBox x:Name="LatAccelBox" Style="{StaticResource Box}" />
                    <TextBlock x:Name="LatAccelRaw" Style="{StaticResource Raw}" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="2">
                    <TextBlock Style="{StaticResource Heading}" Text="Longitudinal Accel" />
                    <TextBox x:Name="LongAccelBox" Style="{StaticResource Box}" />
                    <TextBlock x:Name="LongAccelRaw" Style="{StaticResource Raw}" />
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="0">
                    <TextBlock Style="{StaticResource Heading}" Text="Throttle" />
                    <TextBox x:Name="ThrottleBox" Style="{StaticResource Box}" Foreground="#4ADE80" />
                    <TextBlock x:Name="ThrottleRaw" Style="{StaticResource Raw}" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="2">
                    <TextBlock Style="{StaticResource Heading}" Text="Brake" />
                    <TextBox x:Name="BrakeBox" Style="{StaticResource Box}" Foreground="#EF4444" />
                    <TextBlock x:Name="BrakeRaw" Style="{StaticResource Raw}" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
