<Window x:Class="RacingCoach.Collector.TargetTelemetryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RacingCoach.Collector"
        Title="RacingCoach Target Telemetry"
        Width="732" Height="490" MinWidth="560" MinHeight="410"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Opacity="0.85" Topmost="True" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual" Left="960" Top="520"
        Icon="Assets/collector.ico"
        FontFamily="Segoe UI" FontSize="13" Foreground="#F3F4F6"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="Background" Value="#232428" />
            <Setter Property="BorderBrush" Value="#303136" />
        </Style>
    </Window.Resources>

    <!-- See-through so the sim shows through, drag anywhere to move it -->
    <Border Background="#121315" BorderBrush="#303136" BorderThickness="1" CornerRadius="10" Padding="14,10,14,14">
        <DockPanel>
            <!-- Header, the Target Lap's brake at the car, Reload and a close button -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource HeaderButton}" Content="✕" Click="Close_Click" local:Loc.ToolTip="close"
                        Width="26" Padding="0" />
                <Button DockPanel.Dock="Right" Style="{StaticResource HeaderButton}" local:Loc.Key="reload" Click="Reload_Click"
                        local:Loc.ToolTip="reloadTip" Padding="10,0" Margin="0,0,8,0" />
                <StackPanel DockPanel.Dock="Right" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="BrakeReadout" HorizontalAlignment="Right" FontSize="26" FontWeight="Bold" FontFamily="Consolas"
                               Foreground="#EF4444" Text="—" />
                    <TextBlock HorizontalAlignment="Right" Foreground="#9A9CA3" FontSize="11" local:Loc.Key="target.brake" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontWeight="Bold" FontSize="14">
                        <Run Text="RACINGCOACH" /><Run local:Loc.Key="target.telemetryTitle" Foreground="#DE3341" FontWeight="Normal" />
                    </TextBlock>
                    <TextBlock x:Name="StatusText" Foreground="#9A9CA3" FontSize="12" TextTrimming="CharacterEllipsis" Text="Loading your Target Lap…" />
                </StackPanel>
            </DockPanel>

            <!-- The overlay's Max Brake, Min Speed and UNDERSTEER or OVERSTEER (collapsed if TelemetryEngine.js didn't load) -->
            <local:OverlayStats x:Name="Stats" DockPanel.Dock="Top" Margin="0,0,0,8" />

            <!-- The In-Car Coach's latest message, for a while after it's shown; two lines' space is always kept for
                 it (hidden, not collapsed) so the chart doesn't change size when one shows -->
            <TextBlock x:Name="CoachText" DockPanel.Dock="Top" Foreground="#4ADE80" FontSize="16" FontWeight="SemiBold"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Height="44" Margin="0,0,0,6" Visibility="Hidden" />

            <!-- Under the chart: the overlay's Upcoming Focus Area row, and above it why the focus areas aren't showing -->
            <local:OverlayAreaRow x:Name="AreaRow" DockPanel.Dock="Bottom" />
            <TextBlock x:Name="OverlayStatusText" DockPanel.Dock="Bottom" Foreground="#E3A82B" FontSize="12" TextWrapping="Wrap"
                       Margin="0,8,0,0" Visibility="Collapsed" />

            <!-- The Target Lap's brake (red), 0-100%, over the next stretch of track, with its gear changes across the
                 top, scrolling left as the car moves; the vertical line is the car, and the bar on it the driver's brake -->
            <Border Background="#1A1B1E" BorderBrush="#303136" BorderThickness="1" CornerRadius="6" Padding="0,0,8,0" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="20" />
                    </Grid.RowDefinitions>
                    <Canvas x:Name="YAxis" Grid.Column="0" Grid.Row="0" />
                    <Canvas x:Name="Plot" Grid.Column="1" Grid.Row="0" ClipToBounds="True" SizeChanged="Plot_SizeChanged" />
                    <Canvas x:Name="XAxis" Grid.Column="1" Grid.Row="1" />
                    <TextBlock x:Name="MessageText" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="12" Foreground="#9A9CA3" Visibility="Collapsed" />
                </Grid>
            </Border>
        </DockPanel>
    </Border>
</Window>
