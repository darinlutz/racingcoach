<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the collector's Rotation Model over recorded or synthetic samples (rotation-model/fixtures) and writes
       its results as JSON, so scripts/rotation-model.test.mjs can compare them with the website's
       src/lib/rotationModel.ts. Compiles the collector's own RotationModel/*.cs files, not a copy. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RacingCoach.Collector.Rotation.Replay</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\RacingCoach.Collector\RotationModel\*.cs" Link="RotationModel\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
