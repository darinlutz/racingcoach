<Window x:Class="RacingCoach.Collector.RadioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RacingCoach Driver Radio"
        Width="560" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Opacity="0.85" Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Left="680" Top="40"
        Icon="Assets/collector.ico"
        FontFamily="Segoe UI" FontSize="18" Foreground="#F3F4F6"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- Driver Radio over the sim (DriverRadio.cs): shown while recording and for a few seconds after, styled like the
         other overlays; it never takes the keyboard from iRacing. Drag it anywhere to move it -->
    <Border Background="#E61A1B1E" BorderBrush="#303136" BorderThickness="1" CornerRadius="10" Padding="14,10">
        <DockPanel>
            <Ellipse x:Name="Dot" DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,12,0" VerticalAlignment="Center" Fill="#DE3341" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeadingText" Foreground="#9A9CA3" FontSize="11" FontWeight="SemiBold" Text="DRIVER RADIO" />
                <TextBlock x:Name="BodyText" FontWeight="SemiBold" TextWrapping="Wrap" Text="Recording…" />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
