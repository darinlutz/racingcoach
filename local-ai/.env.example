# Copy to local-ai/.env (git-ignored) on the Mac that runs the models: cp local-ai/.env.example local-ai/.env
# docs/local-ai.md explains each step.

# The same value as LOCAL_AI_SHARED_SECRET on Render. Make one with: node local-ai/gateway.ts secret
LOCAL_AI_SHARED_SECRET=

# This Mac's ID, exactly as registered in Admin > Local AI Server Mode
LOCAL_AI_SERVER_ID=macbook-pro

# Where heartbeats go: the live site's heartbeat route (or http://localhost:3000/api/local-ai/heartbeat for a local dev server)
LOCAL_AI_HEARTBEAT_URL=https://racingcoach.app/api/local-ai/heartbeat

# The gateway cloudflared forwards to. Keep it on 127.0.0.1
LOCAL_AI_GATEWAY_HOST=127.0.0.1
LOCAL_AI_GATEWAY_PORT=8787

# Ollama, on this Mac only (never expose it)
OLLAMA_URL=http://127.0.0.1:11434

# Generations at once (match OLLAMA_NUM_PARALLEL); more are refused and go to the cloud
LOCAL_AI_MAX_CONCURRENCY=2

# The only models the gateway will run
LOCAL_AI_MODELS=gpt-oss:20b,qwen3:8b

# ---- AI Lab (docs/AI_LAB_SETUP.md) ----
# The website's AI Lab page reaches this Mac through the same gateway and tunnel, on /lab/* routes signed apart from
# production's. Off unless turned on here.
LOCAL_AI_LAB=off
# Downloading and deleting models from the AI Lab page (never a model in LOCAL_AI_MODELS)
LOCAL_AI_LAB_MANAGE=off
# Lab generations at once, and their caps; a lab request also waits while every production slot is busy
LOCAL_AI_LAB_MAX_CONCURRENCY=1
LOCAL_AI_LAB_MAX_CONTEXT=32768
LOCAL_AI_LAB_MAX_OUTPUT=4096
LOCAL_AI_LAB_TIMEOUT_MS=180000
# Open WebUI on this Mac (local-ai/openwebui/docker-compose.yml) and an API key from its admin account
# (Open WebUI > Settings > Account > API Keys). The key never leaves this Mac.
OPEN_WEBUI_URL=http://127.0.0.1:8080
OPEN_WEBUI_API_KEY=

# The Memory Service (docs/AI_MEMORY_SETUP.md): the Mem0 sidecar on this Mac, and memory calls at once
# MEM0_URL=http://127.0.0.1:8765
# LOCAL_AI_MEMORY_MAX_CONCURRENCY=1
