{
  "name": "racingcoach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:rotation": "node --test scripts/rotation-model.test.mjs",
    "test:track-positions": "node --test scripts/track-positions.test.mjs",
    "test:lap-retention": "node --test scripts/lap-retention.test.mjs && node --experimental-transform-types --no-warnings --test scripts/lap-retention-db.test.mjs",
    "test:cookie-consent": "node --test scripts/cookie-consent.test.mjs && node --experimental-transform-types --no-warnings --test scripts/cookie-consent-db.test.mjs",
    "test:tv": "node --test scripts/tv-broadcast.test.mjs",
    "test:broadcast": "node --test scripts/race-broadcast.test.mjs",
    "test:tire-temps": "node --experimental-transform-types --no-warnings --test scripts/tire-temps.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.187",
    "@deck.gl/core": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/mesh-layers": "9.4.0",
    "@deck.gl/react": "9.4.0",
    "@deck.gl/widgets": "9.4.0",
    "@langchain/anthropic": "^1.5.13",
    "@langchain/core": "^1.2.1",
    "@langchain/openai": "^1.5.2",
    "axios": "^1.16.1",
    "flag-icons": "7.5.0",
    "langchain": "^1.5.1",
    "langsmith": "^0.7.11",
    "lucide-react": "^1.44.0",
    "next": "^16.2.6",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.4",
    "simple-icons": "16.35.0",
    "stripe": "^23.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
