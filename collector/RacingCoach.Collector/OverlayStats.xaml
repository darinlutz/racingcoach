<UserControl x:Class="RacingCoach.Collector.OverlayStats"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RacingCoach.Collector">
    <UserControl.Resources>
        <ResourceDictionary Source="OverlayStyles.xaml" />
    </UserControl.Resources>

    <!-- Peak brake pressure, minimum speed and largest steering angle of the last few seconds, and the Rotation
         Model's label; under them the focus area just left's time and exit speed -->
    <StackPanel HorizontalAlignment="Left">
    <Grid HorizontalAlignment="Left">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="115" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="115" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <TextBlock Style="{StaticResource Heading}" local:Loc.Key="overlay.maxBrake" />
            <TextBox x:Name="MaxBrakeBox" Style="{StaticResource BigBox}" Foreground="#EF4444" />
        </StackPanel>
        <StackPanel Grid.Column="2">
            <!-- With the speed unit, set in code -->
            <TextBlock x:Name="MinSpeedHeading" Style="{StaticResource Heading}" />
            <TextBox x:Name="MinSpeedBox" Style="{StaticResource BigBox}" Foreground="#8AB4F8" />
        </StackPanel>
        <!-- The largest steering wheel angle (either way), held 5 s like Min Speed; in the website's Peak Steering Δ
             orange (its tele-neg color) -->
        <StackPanel Grid.Column="4">
            <TextBlock Style="{StaticResource Heading}" local:Loc.Key="overlay.maxSteering" />
            <TextBox x:Name="MaxSteeringBox" Style="{StaticResource BigBox}" Foreground="#F98F3A" />
        </StackPanel>
        <!-- UNDERSTEER or OVERSTEER from the Rotation Model while it's sure; hidden (keeping its space) otherwise.
             No heading: it sits at the bottom, level with the Max Brake and Min Speed boxes -->
        <TextBox x:Name="HandlingBox" Grid.Column="6" Style="{StaticResource BigBox}" MinWidth="230" Visibility="Hidden"
                 VerticalAlignment="Bottom" />
    </Grid>

    <!-- The focus area just left: "T3 Time" and "T3 Exit" (purple BEST for a session best), for 3 s after leaving it
         (OverlayEngine's LastAreaHoldMs), then hidden. Hidden rather than collapsed, so the space stays and the
         chart and the In-Car Coach's message under it don't move -->
    <StackPanel x:Name="LastAreaPanel" Orientation="Horizontal" Margin="0,4,0,0" Visibility="Hidden">
        <StackPanel Width="130">
            <TextBlock x:Name="LastTimeHeading" Style="{StaticResource Heading}" />
            <TextBox x:Name="LastTimeBox" Style="{StaticResource MidBox}" Margin="0" />
        </StackPanel>
        <StackPanel Width="130" Margin="10,0,0,0">
            <TextBlock x:Name="LastExitHeading" Style="{StaticResource Heading}" />
            <TextBox x:Name="LastExitBox" Style="{StaticResource MidBox}" Margin="0" />
        </StackPanel>
    </StackPanel>
    </StackPanel>
</UserControl>
