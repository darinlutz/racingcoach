<Window x:Class="RacingCoach.Collector.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RacingCoach.Collector"
        Title="RacingCoach Overlay"
        Width="732" MinWidth="560" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Opacity="0.7" Topmost="True" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual" Left="40" Top="120"
        Icon="Assets/collector.ico"
        FontFamily="Segoe UI" FontSize="13" Foreground="#F3F4F6"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- See-through (Opacity above) so the sim shows through. Drag anywhere to move it. The height fits the
         one row of focus area values. -->
    <Border Background="#121315" BorderBrush="#303136" BorderThickness="1" CornerRadius="10" Padding="14,10,14,14">
        <DockPanel>
            <!-- Header: the track, and a close button -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="✕" Click="Close_Click" local:Loc.ToolTip="overlay.close"
                        Width="26" Height="26" Padding="0" FontSize="12" Cursor="Hand" VerticalAlignment="Top"
                        Foreground="#F3F4F6" Background="#232428" BorderBrush="#303136" />
                <StackPanel>
                    <TextBlock FontWeight="Bold" FontSize="14">
                        <Run Text="RACINGCOACH" /><Run Text=" OVERLAY" Foreground="#DE3341" FontWeight="Normal" />
                    </TextBlock>
                    <TextBlock x:Name="TrackText" Foreground="#9A9CA3" FontSize="12" TextTrimming="CharacterEllipsis" Text="Waiting for iRacing…" />
                </StackPanel>
            </DockPanel>

            <!-- Peak brake pressure and minimum speed of the last few seconds, and UNDERSTEER or OVERSTEER -->
            <local:OverlayStats x:Name="Stats" DockPanel.Dock="Top" Margin="0,0,0,8" />

            <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Foreground="#E3A82B" FontSize="12" TextWrapping="Wrap"
                       Margin="0,0,0,8" Visibility="Collapsed" />

            <!-- The In-Car Coach's latest message, for a while after it's shown -->
            <TextBlock x:Name="CoachText" DockPanel.Dock="Top" Foreground="#4ADE80" FontSize="16" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />

            <!-- The Upcoming Focus Area row: its name, then this lap's values -->
            <local:OverlayAreaRow x:Name="AreaRow" VerticalAlignment="Top" />
        </DockPanel>
    </Border>
</Window>
