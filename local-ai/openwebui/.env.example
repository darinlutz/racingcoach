# Copy to local-ai/openwebui/.env (git-ignored) on the Mac: cp .env.example .env
# docs/AI_LAB_SETUP.md explains each step. Stays on the Mac: nothing here goes to Render.

# Signs Open WebUI's sessions and encrypts its stored secrets. Make one with: openssl rand -hex 32
# Keep it: a new one signs everyone out, and losing it with a backup makes stored connection keys unreadable.
WEBUI_SECRET_KEY=

# The release to run (tags on ghcr.io/open-webui/open-webui). Change it to update; back up first.
OPEN_WEBUI_VERSION=v0.13.4

# Its public address through Cloudflare Tunnel (behind Cloudflare Access)
WEBUI_URL=https://ai-lab.racingcoach.app

# The embedding model for knowledge bases, pulled in Ollama first (ollama pull qwen3-embedding:0.6b).
# Read on the first start only; afterwards change it in Admin Panel > Settings > Documents (and re-index).
RAG_EMBEDDING_MODEL=qwen3-embedding:0.6b
