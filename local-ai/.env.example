# Copy to local-ai/.env (git-ignored) on the Mac that runs the models: cp local-ai/.env.example local-ai/.env
# docs/local-ai.md explains each step.

# The same value as LOCAL_AI_SHARED_SECRET on Render. Make one with: node local-ai/gateway.ts secret
LOCAL_AI_SHARED_SECRET=

# This Mac's ID, exactly as registered in Admin > Local AI Server Mode
LOCAL_AI_SERVER_ID=macbook-pro

# Where heartbeats go: the live site's heartbeat route (or http://localhost:3000/api/local-ai/heartbeat for a local dev server)
LOCAL_AI_HEARTBEAT_URL=https://racingcoach.app/api/local-ai/heartbeat

# The gateway cloudflared forwards to. Keep it on 127.0.0.1
LOCAL_AI_GATEWAY_HOST=127.0.0.1
LOCAL_AI_GATEWAY_PORT=8787

# Ollama, on this Mac only (never expose it)
OLLAMA_URL=http://127.0.0.1:11434

# Generations at once (match OLLAMA_NUM_PARALLEL); more are refused and go to the cloud
LOCAL_AI_MAX_CONCURRENCY=2

# The only models the gateway will run
LOCAL_AI_MODELS=gpt-oss:20b,qwen3:8b
