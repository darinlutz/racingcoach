<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests of RacingCoach.Collector.Core alone: plain net10.0, no WPF or simulator SDK, so they run on any OS
       (dotnet test collector/RacingCoach.Collector.Core.Tests, or npm run test:collector-core). The collector's own
       tests, which need Windows, are in RacingCoach.Collector.Tests. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>RacingCoach.Collector.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RacingCoach.Collector.Core\RacingCoach.Collector.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
