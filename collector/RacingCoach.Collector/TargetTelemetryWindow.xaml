<Window x:Class="RacingCoach.Collector.TargetTelemetryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RacingCoach Target Telemetry"
        Width="640" Height="300" MinWidth="360" MinHeight="220"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Opacity="0.85" Topmost="True" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual" Left="960" Top="520"
        Icon="Assets/collector.ico"
        FontFamily="Segoe UI" FontSize="13" Foreground="#F3F4F6"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="Background" Value="#232428" />
            <Setter Property="BorderBrush" Value="#303136" />
        </Style>
    </Window.Resources>

    <!-- Looks like the overlay (OverlayWindow.xaml): see-through so the sim shows through, drag anywhere to move it -->
    <Border Background="#121315" BorderBrush="#303136" BorderThickness="1" CornerRadius="10" Padding="14,10,14,14">
        <DockPanel>
            <!-- Header, the Target Lap's brake at the car, Reload and a close button -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource HeaderButton}" Content="✕" Click="Close_Click" ToolTip="Close"
                        Width="26" Padding="0" />
                <Button DockPanel.Dock="Right" Style="{StaticResource HeaderButton}" Content="Reload" Click="Reload_Click"
                        ToolTip="Load your Target Lap again (after changing it on the Account page)" Padding="10,0" Margin="0,0,8,0" />
                <StackPanel DockPanel.Dock="Right" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="BrakeReadout" HorizontalAlignment="Right" FontSize="26" FontWeight="Bold" FontFamily="Consolas"
                               Foreground="#EF4444" Text="—" />
                    <TextBlock HorizontalAlignment="Right" Foreground="#9A9CA3" FontSize="11" Text="target brake" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontWeight="Bold" FontSize="14">
                        <Run Text="RACINGCOACH" /><Run Text=" TARGET TELEMETRY" Foreground="#3B8BFF" FontWeight="Normal" />
                    </TextBlock>
                    <TextBlock x:Name="StatusText" Foreground="#9A9CA3" FontSize="12" TextTrimming="CharacterEllipsis" Text="Loading your Target Lap…" />
                </StackPanel>
            </DockPanel>

            <!-- The Target Lap's brake (0-100%) over the next stretch of track, scrolling left as the car moves; the
                 vertical line is the car -->
            <Border Background="#1A1B1E" BorderBrush="#303136" BorderThickness="1" CornerRadius="6" Padding="0,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="20" />
                    </Grid.RowDefinitions>
                    <Canvas x:Name="YAxis" Grid.Column="0" Grid.Row="0" />
                    <Canvas x:Name="Plot" Grid.Column="1" Grid.Row="0" ClipToBounds="True" SizeChanged="Plot_SizeChanged" />
                    <Canvas x:Name="XAxis" Grid.Column="1" Grid.Row="1" />
                    <TextBlock x:Name="MessageText" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="12" Foreground="#9A9CA3" Visibility="Collapsed" />
                </Grid>
            </Border>
        </DockPanel>
    </Border>
</Window>
