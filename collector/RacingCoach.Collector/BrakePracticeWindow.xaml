<Window x:Class="RacingCoach.Collector.BrakePracticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RacingCoach Brake Practice"
        Width="560" Height="380" MinWidth="360" MinHeight="260"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Opacity="0.85" Topmost="True" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual" Left="960" Top="120"
        Icon="Assets/collector.ico"
        FontFamily="Segoe UI" FontSize="13" Foreground="#F3F4F6"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- Looks like the overlay (OverlayWindow.xaml): see-through so the sim shows through, drag anywhere to move it -->
    <Border Background="#121315" BorderBrush="#303136" BorderThickness="1" CornerRadius="10" Padding="14,10,14,14">
        <DockPanel>
            <!-- Header and a close button -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="✕" Click="Close_Click" ToolTip="Close"
                        Width="26" Height="26" Padding="0" FontSize="12" Cursor="Hand" VerticalAlignment="Top"
                        Foreground="#F3F4F6" Background="#232428" BorderBrush="#303136" />
                <!-- The exact brake percentage being applied -->
                <TextBlock x:Name="BrakeReadout" DockPanel.Dock="Right" Margin="0,0,12,0" VerticalAlignment="Center"
                           FontSize="34" FontWeight="Bold" FontFamily="Consolas" Foreground="#EF4444" Text="—" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontWeight="Bold" FontSize="14">
                        <Run Text="RACINGCOACH" /><Run Text=" BRAKE PRACTICE" Foreground="#3B8BFF" FontWeight="Normal" />
                    </TextBlock>
                    <TextBlock x:Name="StatusText" Foreground="#9A9CA3" FontSize="12" TextTrimming="CharacterEllipsis" Text="Waiting for iRacing…" />
                </StackPanel>
            </DockPanel>

            <!-- Brake % over the last few seconds, newest on the right, with lines at 20, 40, 60, 80 and 100% -->
            <Border Background="#1A1B1E" BorderBrush="#303136" BorderThickness="1" CornerRadius="6">
                <Canvas x:Name="Graph" ClipToBounds="True" SizeChanged="Graph_SizeChanged" />
            </Border>
        </DockPanel>
    </Border>
</Window>
