<UserControl x:Class="RacingCoach.Collector.OverlayStats"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RacingCoach.Collector">
    <UserControl.Resources>
        <ResourceDictionary Source="OverlayStyles.xaml" />
    </UserControl.Resources>

    <!-- One row: peak brake pressure, minimum speed and largest steering angle of the last few seconds; the focus area
         just left's time, exit speed, Wheel° Diff and Wheel Point Diff; and the Rotation Model's label -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="98" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="95" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <TextBlock Style="{StaticResource Heading}" local:Loc.Key="overlay.maxBrake" />
            <TextBox x:Name="MaxBrakeBox" Style="{StaticResource BigBox}" Foreground="#EF4444" />
        </StackPanel>
        <StackPanel Grid.Column="2">
            <!-- With the speed unit, set in code -->
            <TextBlock x:Name="MinSpeedHeading" Style="{StaticResource Heading}" />
            <TextBox x:Name="MinSpeedBox" Style="{StaticResource BigBox}" Foreground="#8AB4F8" />
        </StackPanel>
        <!-- The largest steering wheel angle (either way), held 5 s like Min Speed; in the website's Peak Steering Δ
             orange (its tele-neg color) -->
        <StackPanel Grid.Column="4">
            <TextBlock Style="{StaticResource Heading}" local:Loc.Key="overlay.maxSteering" />
            <TextBox x:Name="MaxSteeringBox" Style="{StaticResource BigBox}" Foreground="#F98F3A" />
        </StackPanel>

        <!-- The focus area just left: "T3 Time", "T3 Exit" (purple BEST for a session best), "Wheel Δ" and
             "Max Point", in the focus area row's boxes (not bold), for 3 s after leaving it (OverlayEngine's LastAreaHoldMs), then hidden. Hidden
             rather than collapsed, so nothing beside or under it moves. Level with the bottoms of the big boxes -->
        <StackPanel x:Name="LastAreaPanel" Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Bottom" Visibility="Hidden">
            <StackPanel Width="72">
                <TextBlock x:Name="LastTimeHeading" Style="{StaticResource Heading}" />
                <TextBox x:Name="LastTimeBox" Style="{StaticResource Box}" />
            </StackPanel>
            <StackPanel Width="109" Margin="6,0,0,0">
                <TextBlock x:Name="LastExitHeading" Style="{StaticResource Heading}" />
                <TextBox x:Name="LastExitBox" Style="{StaticResource Box}" />
            </StackPanel>
            <StackPanel Width="82" Margin="6,0,0,0">
                <TextBlock x:Name="LastWheelDiffHeading" Style="{StaticResource Heading}" />
                <TextBox x:Name="LastWheelDiffBox" Style="{StaticResource Box}" />
            </StackPanel>
            <StackPanel Width="122" Margin="6,0,0,0">
                <TextBlock x:Name="LastWheelPointHeading" Style="{StaticResource Heading}" />
                <TextBox x:Name="LastWheelPointBox" Style="{StaticResource Box}" />
            </StackPanel>
        </StackPanel>

        <!-- UNDERSTEER or OVERSTEER from the Rotation Model while it's sure; hidden (keeping its space) otherwise.
             No heading: it sits at the bottom, level with the other boxes. Shrunk to fit what's left of the row when the
             window is narrow, rather than cut off -->
        <Viewbox Grid.Column="8" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Bottom">
            <TextBox x:Name="HandlingBox" Style="{StaticResource MidBox}" MinWidth="126" Visibility="Hidden" />
        </Viewbox>
    </Grid>
</UserControl>
